# Copy this file to .env and fill in real values.
# Get the strings from: Neon console -> project -> Connect.
#
#  DATABASE_URL = pooled host  (-pooler)  -> app / serverless runtime
#  DIRECT_URL   = direct host  (no -pooler) -> psql -f, DDL, pg_dump
#
# Ask a teammate privately for the password. Never commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxxxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxxxxx.REGION.aws.neon.tech/neondb?sslmode=require"
